# MediMind environment configuration — TEMPLATE
#
# Copy this file to `.env.local` and fill in your own values:
#     Copy-Item .env.example .env.local
#
# `.env.local` is git-ignored and must NEVER be committed.
#
# ------------------------------------------------------------------------------
# IMPORTANT SECURITY NOTE (Phase 18)
# ------------------------------------------------------------------------------
# Anything prefixed with EXPO_PUBLIC_ is compiled INTO the app bundle and can be
# read by anyone who downloads the app. Only put publishable values here.
#
# The Anthropic API key is deliberately NOT in this file. It is stored as a
# secret on the Supabase Edge Function and never reaches the device.
# ------------------------------------------------------------------------------

# Supabase project (Milestone 2). Find these at:
#   Supabase dashboard → Project Settings → Data API
# The anon key is a public client key; every table is protected by Row Level
# Security, so a user can only ever read their own rows.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL of the Edge Function that performs AI label extraction (Milestone 4).
# Leave blank to keep the app in demo mode with the mock scanner.
EXPO_PUBLIC_SCAN_ENDPOINT=

# Optional: URL of the deployed `assistant` Supabase Edge Function. When unset
# (or while Demo Mode is on) the built-in offline assistant answers instead.
# EXPO_PUBLIC_ASSISTANT_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/assistant
